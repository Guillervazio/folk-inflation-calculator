# Los finales de línea son corrección, no preferencia: el .editorconfig declara
# end_of_line = lf, y sin este fichero git normalizaría a CRLF en Windows y las
# herramientas de formato reportarían cada fichero como modificado.
* text=auto eol=lf

# Lo que sólo ejecuta Windows, donde el .editorconfig también dice crlf.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Fotos de tickets del conjunto de referencia (S4) y demás binarios: git no los toca.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.heic binary
*.pdf binary
*.ico binary
*.woff  binary
*.woff2 binary
